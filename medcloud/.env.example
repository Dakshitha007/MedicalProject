# Environment variables required for secure production deployment

# Django settings
DJANGO_SECRET_KEY=replace_me_with_a_random_secure_key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SESSION_COOKIE_SAMESITE=Strict
DJANGO_CSRF_COOKIE_SAMESITE=Strict
DJANGO_SECURE_REFERRER_POLICY=same-origin
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_LOG_LEVEL=INFO

# Cryptographic secrets
FILE_ENCRYPTION_SECRET=replace_me_with_a_unique_aes_key_secret
BLOCKCHAIN_SIGNING_SECRET=replace_me_with_a_unique_hmac_secret

# HSM and threshold key custody
HSM_ENABLED=True
HSM_PROVIDER=local
HSM_KEY_ID=medcloud_master_key
HSM_THRESHOLD=3
HSM_PARTY_COUNT=5
KEY_CUSTODY_PARTIES=custodian1,custodian2,custodian3
KEY_SHARE_DIR=/var/medcloud/hsm_shares

# Service identity and mTLS
MTLS_REQUIRED=True
MTLS_ALLOWED_CLIENT_FINGERPRINTS=
CERTIFICATE_PINNING_FINGERPRINTS=

# SIEM and monitoring
SIEM_INGEST_URL=https://siem.example.com/ingest
SIEM_API_TOKEN=replace_me_with_siem_api_token
UEBA_ENABLED=True

# Disaster recovery and compliance
DISASTER_RECOVERY_REGIONS=us-east-1,us-west-2,eu-west-1
COMPLIANCE_FRAMEWORKS=HIPAA,GDPR,ISO27001,SOC2

# PostgreSQL database
POSTGRES_DB=medcloud_db
POSTGRES_USER=medcloud_user
POSTGRES_PASSWORD=replace_me_with_db_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Optional local development override
USE_SQLITE=False
